{%- comment -%}
  Fyxx: Wine details
  Splits a structured wine description into placed parts, below the taste block.

  The description stays the single source of truth in product.description. The
  six-part template is: an opening <em> paragraph (rendered by wine-lead), then
  Tasting Notes, Quick Facts, Food Pairing, Serving and About the Producer, each
  introduced by a <p><strong>Heading</strong> line.

  Two heading-body shapes exist in the catalogue and both are handled:
    1. br-joined:   <p><strong>Tasting Notes</strong><br>text here</p>
    2. separate <p>: <p><strong>Tasting Notes</strong></p><p>text here</p>
  For each part we take everything from the heading up to the next heading
  (the next "<p><strong>"), drop a leading "</p>" (shape 2) or leading "<br>"
  (shape 1), and ensure the body is wrapped in a paragraph. This captures the
  whole body even if a part ever spans more than one paragraph, so nothing is
  truncated.

  Render decision (fail safe):
    - Three or more of the five headings present: render the parts below. Any
      individual missing part is skipped, no empty heading.
    - Fewer than three: render the WHOLE description plainly. The Description
      accordion is removed from this template, so rendering nothing would drop
      the content. This branch is the safety net; 0 of 680 wines hit it today.

  No font-family name is declared. Section headings are small uppercase
  eyebrows in the inherited theme body font. Tasting Notes and Goes with use
  the theme heading variable for their serif body. The producer is an open
  section, not an accordion. Only the brand palette is used: ink #100F0D,
  blush #F8D3D7, and alpha steps of ink.
  The outer container is the theme's full page-width; the text is capped at the
  narrow measure (--page-narrow) and left aligned, so its left edge lines up with
  the buy column above rather than being centred.
{%- endcomment -%}

{%- liquid
  assign desc = product.description

  assign hcount = 0
  if desc contains '<strong>Tasting Notes</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>Quick Facts</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>Food Pairing</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>Serving</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>About the Producer</strong>'
    assign hcount = hcount | plus: 1
  endif
-%}

{%- if hcount >= 3 -%}
  {%- liquid
    # ---- Tasting Notes: body from heading to next heading, as HTML ----
    assign tasting = ''
    if desc contains '<strong>Tasting Notes</strong>'
      assign tn = desc | split: '<strong>Tasting Notes</strong>' | last | split: '<p><strong>' | first | strip
      assign tn4 = tn | slice: 0, 4
      if tn4 == '</p>'
        assign tn = tn | remove_first: '</p>' | strip
      endif
      assign tn = tn | remove_first: '<br>' | remove_first: '<br/>' | remove_first: '<br />' | strip
      assign tn2 = tn | slice: 0, 2
      if tn2 != '<p'
        assign tn = tn | prepend: '<p>'
      endif
      assign tasting = tn
    endif

    # ---- Food Pairing (Goes with) ----
    assign pairing = ''
    if desc contains '<strong>Food Pairing</strong>'
      assign fp = desc | split: '<strong>Food Pairing</strong>' | last | split: '<p><strong>' | first | strip
      assign fp4 = fp | slice: 0, 4
      if fp4 == '</p>'
        assign fp = fp | remove_first: '</p>' | strip
      endif
      assign fp = fp | remove_first: '<br>' | remove_first: '<br/>' | remove_first: '<br />' | strip
      assign fp2 = fp | slice: 0, 2
      if fp2 != '<p'
        assign fp = fp | prepend: '<p>'
      endif
      assign pairing = fp
    endif

    # ---- About the Producer ----
    assign about = ''
    if desc contains '<strong>About the Producer</strong>'
      assign ab = desc | split: '<strong>About the Producer</strong>' | last | split: '<p><strong>' | first | strip
      assign ab4 = ab | slice: 0, 4
      if ab4 == '</p>'
        assign ab = ab | remove_first: '</p>' | strip
      endif
      assign ab = ab | remove_first: '<br>' | remove_first: '<br/>' | remove_first: '<br />' | strip
      assign ab2 = ab | slice: 0, 2
      if ab2 != '<p'
        assign ab = ab | prepend: '<p>'
      endif
      assign about = ab
    endif

    # ---- Serving: plain text, trim the leading temperature sentence only ----
    assign serving_out = ''
    if desc contains '<strong>Serving</strong>'
      assign sv = desc | split: '<strong>Serving</strong>' | last | split: '<p><strong>' | first | strip_html | strip
      assign sv8 = sv | slice: 0, 8
      if sv8 == 'Serve at'
        if sv contains '. '
          assign first_sentence = sv | split: '. ' | first
          assign serving_out = sv | remove_first: first_sentence | remove_first: '. ' | strip
        else
          assign after_temp = sv | split: '°C' | last | replace: '.', '' | replace: ',', '' | strip
          if after_temp == blank
            assign serving_out = ''
          else
            assign serving_out = sv
          endif
        endif
      else
        assign serving_out = sv
      endif
    endif

    # ---- Quick Facts: the <li> items inside the FIRST <ul> after the heading ----
    assign qf_raw = ''
    if desc contains '<strong>Quick Facts</strong>'
      assign qf_after = desc | split: '<strong>Quick Facts</strong>' | last
      assign qf_parts = qf_after | split: '<ul>'
      if qf_parts.size > 1
        assign qf_raw = qf_parts[1] | split: '</ul>' | first
      endif
    endif
  -%}

  <div class="wine-details" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
    <div class="page-width">
      <div class="wine-details__inner">

      {%- if serving_out != blank -%}
        <p class="wine-details__serving">{{ serving_out }}</p>
      {%- endif -%}

      {%- if tasting != blank -%}
        <section class="wine-details__block wine-details__block--tasting">
          <h2 class="fx-eyebrow">Tasting Notes</h2>
          <div class="wine-details__serif">{{ tasting }}</div>
        </section>
      {%- endif -%}

      {%- if pairing != blank -%}
        <section class="wine-details__block wine-details__block--goes">
          <h3 class="fx-eyebrow">Goes with</h3>
          <div class="wine-details__serif">{{ pairing }}</div>
        </section>
      {%- endif -%}

      {%- if qf_raw != blank -%}
        <section class="wine-details__block wine-details__block--facts">
          <h3 class="fx-eyebrow">The facts</h3>
          <dl class="wine-facts">
            {%- assign qf_items = qf_raw | split: '<li>' -%}
            {%- for item in qf_items -%}
              {%- assign li = item | split: '</li>' | first | strip_html | strip -%}
              {%- if li != blank -%}
                {%- if li contains ':' -%}
                  {%- assign lbl = li | split: ':' | first | strip -%}
                  {%- assign val = li | remove_first: lbl | remove_first: ':' | strip -%}
                  <div class="wine-facts__pair">
                    <dt class="wine-facts__label">{{ lbl }}</dt>
                    <dd class="wine-facts__value">{{ val }}</dd>
                  </div>
                {%- else -%}
                  <div class="wine-facts__pair">
                    <dd class="wine-facts__value">{{ li }}</dd>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </dl>
        </section>
      {%- endif -%}

      {%- if about != blank -%}
        <section class="wine-details__block wine-details__block--producer">
          <hr class="wine-details__rule" aria-hidden="true">
          <h3 class="fx-eyebrow">The producer</h3>
          <div class="wine-details__producer-body">{{ about }}</div>
        </section>
      {%- endif -%}

      </div>
    </div>
  </div>

  <style>
    .wine-details__inner { max-width: var(--page-narrow); }

    .fx-eyebrow {
      margin: 0;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(16, 15, 13, 0.72);
    }

    .wine-details__serving {
      font-size: 13.5px;
      line-height: 1.6;
      color: rgba(16, 15, 13, 0.72);
      margin: 0;
    }

    .wine-details__serif {
      font-family: var(--element-text-font-family--heading);
      font-size: 16px;
      line-height: 1.75;
      font-weight: 400;
      font-style: normal;
      color: rgba(16, 15, 13, 0.88);
    }
    .wine-details__serif p { margin: 0 0 0.75rem; }
    .wine-details__serif p:last-child { margin-bottom: 0; }

    .wine-details__block--tasting { margin-top: 56px; }
    .wine-details__block--goes { margin-top: 48px; }
    .wine-details__block--tasting .fx-eyebrow,
    .wine-details__block--goes .fx-eyebrow { margin-bottom: 16px; }

    .wine-details__block--facts { margin-top: 48px; }
    .wine-details__block--facts .fx-eyebrow { margin-bottom: 18px; }
    .wine-facts {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .wine-facts__pair { margin: 0; }
    .wine-facts__label {
      margin: 0 0 3px;
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(16, 15, 13, 0.55);
    }
    .wine-facts__value {
      margin: 0;
      font-size: 15px;
      line-height: 1.5;
      color: #100F0D;
    }

    .wine-details__block--producer { margin-top: 56px; }
    .wine-details__rule {
      width: 56px;
      height: 3px;
      background: #F8D3D7;
      border: 0;
      margin: 0 0 20px;
    }
    .wine-details__block--producer .fx-eyebrow { margin-bottom: 16px; }
    .wine-details__producer-body {
      font-size: 15px;
      line-height: 1.7;
      color: rgba(16, 15, 13, 0.88);
    }
    .wine-details__producer-body p { margin: 0 0 0.75rem; }
    .wine-details__producer-body p:last-child { margin-bottom: 0; }

    @media screen and (max-width: 768px) {
      .wine-details__inner { max-width: none; }
    }
  </style>

{%- else -%}

  {%- comment -%} Fewer than three headings: render the whole description plainly, nothing dropped. {%- endcomment -%}
  <div class="wine-details wine-details--fallback" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
    <div class="page-width">
      <div class="wine-details__inner">
        {{ product.description }}
      </div>
    </div>
  </div>
  <style>
    .wine-details__inner { max-width: var(--page-narrow); }
    @media screen and (max-width: 768px) {
      .wine-details__inner { max-width: none; }
    }
  </style>

{%- endif -%}

{% schema %}
{
  "name": "Wine details",
  "tag": "section",
  "class": "section wine-details-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wine details"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Wine details"
    }
  ]
}
{% endschema %}
