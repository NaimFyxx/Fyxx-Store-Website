{%- comment -%}
  Fyxx: Wine lead
  Renders the opening paragraph of a wine description, meaning the content
  before the first "<p><strong>" heading. It only renders when the description
  is in the structured six-part shape (three or more of the five known
  headings), so an odd description never has its whole body rendered here as a
  lead. Renders nothing otherwise, and nothing if there is no content before
  the first heading. See sections/wine-details.liquid for the matching parse.

  Font: the lead uses the theme's heading font via its token (resolves to Libre
  Baskerville on this theme), set through the token rather than a hardcoded
  family name so it tracks any future theme font change. The paragraph is
  already wrapped in <em> in the data, so italics are not set in CSS.
{%- endcomment -%}

{%- liquid
  assign desc = product.description

  assign hcount = 0
  if desc contains '<strong>Tasting Notes</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>Quick Facts</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>Food Pairing</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>Serving</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>About the Producer</strong>'
    assign hcount = hcount | plus: 1
  endif

  assign lead = ''
  if hcount >= 3
    assign lead = desc | split: '<p><strong>' | first | strip
  endif
-%}

{%- if lead != blank -%}
  <div class="wine-lead" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
    <div class="wine-lead__inner page-width page-width--narrow">
      {{ lead }}
    </div>
  </div>

  <style>
    .wine-lead__inner,
    .wine-lead__inner p,
    .wine-lead__inner em {
      font-family: var(--element-text-font-family--heading), var(--element-text-font-family-fallback--heading);
      font-size: 18px;
      line-height: 1.72;
      color: #2b2b2b;
    }
    .wine-lead__inner p { margin: 0; }
    @media screen and (max-width: 768px) {
      .wine-lead__inner.page-width--narrow { max-width: none; }
      .wine-lead__inner,
      .wine-lead__inner p,
      .wine-lead__inner em { font-size: 15px; }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Wine lead",
  "tag": "section",
  "class": "section wine-lead-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Wine lead"
    }
  ]
}
{% endschema %}
