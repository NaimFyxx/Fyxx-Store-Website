{%- comment -%}
  Fyxx: Taste Characteristics
  Reads product.metafields.taste.*
  Renders nothing unless all four scale values (1-5) are present.
{%- endcomment -%}

{%- liquid
  assign m = product.metafields.taste
  assign body = m.body.value
  assign structure = m.structure.value
  assign sweetness = m.sweetness.value
  assign acidity = m.acidity.value
  assign temp = m.serve_temp_c.value
  assign temp_high = m.serve_temp_high_c.value
  assign summary = m.summary.value
  assign scale_set = m.scale_set.value | default: 'red' | downcase

  assign filled = 0
  if body > 0 and body <= 5
    assign filled = filled | plus: 1
  endif
  if structure > 0 and structure <= 5
    assign filled = filled | plus: 1
  endif
  if sweetness > 0 and sweetness <= 5
    assign filled = filled | plus: 1
  endif
  if acidity > 0 and acidity <= 5
    assign filled = filled | plus: 1
  endif

  assign l1 = 'Light'
  assign r1 = 'Full'
  assign l2 = 'Smooth'
  assign r2 = 'Tannic'
  assign l3 = 'Dry'
  assign r3 = 'Sweet'
  assign l4 = 'Soft'
  assign r4 = 'Fresh'

  case scale_set
    when 'white' or 'rose'
      assign l1 = 'Light'
      assign r1 = 'Bold'
      assign l2 = 'Delicate'
      assign r2 = 'Aromatic'
      assign l3 = 'Dry'
      assign r3 = 'Sweet'
      assign l4 = 'Soft'
      assign r4 = 'Acidic'
    when 'sparkling'
      assign l1 = 'Light'
      assign r1 = 'Full'
      assign l2 = 'Fine'
      assign r2 = 'Vigorous'
      assign l3 = 'Dry'
      assign r3 = 'Sweet'
      assign l4 = 'Soft'
      assign r4 = 'Fresh'
    when 'spirit'
      assign l1 = 'Light'
      assign r1 = 'Rich'
      assign l2 = 'Gentle'
      assign r2 = 'Fiery'
      assign l3 = 'Dry'
      assign r3 = 'Sweet'
      assign l4 = 'Clean'
      assign r4 = 'Smoky'
  endcase

  assign show_chill = false
  if scale_set == 'red' and m.chill_red.value == true
    assign show_chill = true
  endif
-%}

{%- if filled >= 4 -%}
<div class="fx-taste" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="fx-taste__inner">

    <hr class="fx-taste__rule" aria-hidden="true">

    <div class="fx-taste__eyebrow-row">
      <span class="fx-taste__dot" aria-hidden="true"></span>
      <h2 class="fx-eyebrow">How it tastes</h2>
    </div>

    <div class="fx-taste__grid">

      {%- assign rows = 'body,structure,sweetness,acidity' | split: ',' -%}
      {%- for row in rows -%}
        {%- liquid
          case row
            when 'body'
              assign v = body
              assign lo = l1
              assign hi = r1
            when 'structure'
              assign v = structure
              assign lo = l2
              assign hi = r2
            when 'sweetness'
              assign v = sweetness
              assign lo = l3
              assign hi = r3
            when 'acidity'
              assign v = acidity
              assign lo = l4
              assign hi = r4
          endcase
          assign offset = v | minus: 1 | times: 20
        -%}
        <div class="fx-taste__row">
          <span class="fx-taste__label fx-taste__label--lo">{{ lo }}</span>
          <div class="fx-taste__track" role="img" aria-label="{{ lo }} to {{ hi }}: {{ v }} out of 5">
            <span class="fx-taste__fill" style="left:{{ offset }}%;width:20%;"></span>
          </div>
          <span class="fx-taste__label fx-taste__label--hi">{{ hi }}</span>
        </div>
      {%- endfor -%}

    </div>

    {%- if temp > 0 -%}
      <div class="fx-taste__serve">
        <span class="fx-taste__serve-label">Serve at</span>
        <div class="fx-taste__serve-main">
          <span class="fx-taste__serve-temp">
            {%- if temp_high > 0 and temp_high != temp -%}
              {{ temp }}&ndash;{{ temp_high }}&deg;C
            {%- else -%}
              {{ temp }}&deg;C
            {%- endif -%}
          </span>
          {%- if show_chill -%}
            <span class="fx-taste__chip">Chill this red</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if summary != blank -%}
      <p class="fx-taste__summary">{{ summary }}</p>
    {%- endif -%}

    </div>
  </div>
</div>

<style>
  .fx-taste__inner { max-width: var(--page-narrow); }

  .fx-taste__rule {
    width: 100%;
    height: 2px;
    background: #100F0D;
    border: 0;
    margin: 0 0 18px;
  }
  .fx-taste__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .fx-taste__dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #F8D3D7;
    flex: none;
  }
  .fx-eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #100F0D;
  }

  .fx-taste__grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 28px;
  }
  .fx-taste__row {
    display: grid;
    grid-template-columns: 6.5rem 1fr 6.5rem;
    align-items: center;
    gap: 1rem;
  }
  .fx-taste__label {
    font-weight: 600;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(16, 15, 13, 0.72);
    white-space: nowrap;
  }
  .fx-taste__label--hi {
    text-align: right;
  }
  .fx-taste__track {
    position: relative;
    height: 6px;
    border-radius: 3px;
    background: #EFEFEF;
    overflow: hidden;
  }
  .fx-taste__fill {
    position: absolute;
    top: 0;
    bottom: 0;
    background: #100F0D;
    border-radius: 3px;
  }

  .fx-taste__serve {
    margin-top: 38px;
  }
  .fx-taste__serve-label {
    display: block;
    font-weight: 600;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(16, 15, 13, 0.72);
  }
  .fx-taste__serve-main {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    margin-top: 6px;
  }
  .fx-taste__serve-temp {
    font-family: var(--element-text-font-family--heading);
    font-size: 44px;
    line-height: 1;
    color: #100F0D;
  }
  .fx-taste__chip {
    font-weight: 700;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #100F0D;
    background: #F8D3D7;
    border-radius: 999px;
    padding: 7px 12px;
  }
  .fx-taste__summary {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(16, 15, 13, 0.72);
    margin: 16px 0 0;
  }

  @media screen and (min-width: 768px) {
    .fx-taste__serve {
      margin-top: 52px;
    }
  }
  /* Mirror the theme: .product-full-width drops its narrow cap below 769px and
     goes full width. This section is not inside .product-full-width, so match
     that here, otherwise the block would stay capped and narrower than the
     rest of the column on phones. */
  @media screen and (max-width: 768px) {
    .fx-taste__inner {
      max-width: none;
    }
  }
  @media screen and (max-width: 749px) {
    .fx-taste__row {
      grid-template-columns: 1fr 1fr;
      gap: 8px 1rem;
    }
    .fx-taste__label--lo {
      grid-column: 1;
      grid-row: 1;
    }
    .fx-taste__label--hi {
      grid-column: 2;
      grid-row: 1;
      text-align: right;
    }
    .fx-taste__track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-taste__fill {
      transition: none;
    }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Taste Characteristics",
  "tag": "section",
  "class": "section fx-taste-section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Taste Characteristics"
    }
  ]
}
{% endschema %}
