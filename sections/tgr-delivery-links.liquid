{%- comment -%}
  FYXX CUSTOM: The Green Room delivery handoff page (/pages/tgr-food-delivery).
  Single-purpose: land, tap Talabat or Careem, get passed to that app. Nothing else.
  All CSS is scoped under .tgr-delivery so nothing leaks if this section is reused.
  Talabat/Careem URLs are pre-filled as fallbacks (the url schema type cannot carry a
  default); either can be overridden in the theme editor.
{%- endcomment -%}

{%- liquid
  assign talabat_url = section.settings.talabat_url
  if talabat_url == blank
    assign talabat_url = 'https://www.talabat.com/jordan/the-green-room'
  endif
  assign careem_url = section.settings.careem_url
  if careem_url == blank
    assign careem_url = 'https://link.careem.com/6Ji9HgnuliPV1'
  endif
  assign has_talabat = false
  if talabat_url != blank
    assign has_talabat = true
  endif
  assign has_careem = false
  if careem_url != blank
    assign has_careem = true
  endif
-%}

{%- if section.settings.noindex -%}
  <meta name="robots" content="noindex, nofollow">
{%- endif -%}

<style>
  .tgr-delivery {
    min-height: 100svh;
    background: #092727;
    color: rgba(255, 255, 255, 0.72);
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px calc(40px + env(safe-area-inset-bottom));
  }
  .tgr-delivery, .tgr-delivery * { box-sizing: border-box; }
  .tgr-delivery__inner {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .tgr-delivery__logo {
    display: block;
    width: auto;
    height: auto;
    max-height: 76px;
    max-width: 74%;
    margin: 0 auto 26px;
  }
  .tgr-delivery__wordmark {
    font-family: 'Baskervville', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: 22px;
    letter-spacing: 0.5px;
    color: #EEC36A;
    margin: 0 auto 26px;
  }
  .tgr-delivery__heading {
    font-family: 'Baskervville', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: 40px;
    line-height: 1.05;
    color: #EEC36A;
    margin: 0 0 10px;
  }
  .tgr-delivery__subheading {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    margin: 0 0 26px;
  }
  .tgr-delivery__placeholder {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    margin: 6px 0 0;
  }
  .tgr-delivery__buttons {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }
  .tgr-delivery__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 60px;
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: filter 0.15s ease, transform 0.05s ease;
  }
  .tgr-delivery__btn-logo {
    display: block;
    height: 22px;
    width: auto;
    flex: 0 0 auto;
  }
  .tgr-delivery__btn--talabat { background: #FF5A00; color: #FFFFFF; }
  .tgr-delivery__btn--careem  { background: #00E784; color: #00493E; }
  .tgr-delivery__btn:hover  { filter: brightness(1.04); }
  .tgr-delivery__btn:active { filter: brightness(0.96); transform: translateY(1px); }
  .tgr-delivery__btn:focus-visible { outline: 2px solid #EEC36A; outline-offset: 2px; }
  .tgr-delivery__footnote {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.70);
    margin: 22px 0 0;
  }

  @media (min-width: 750px) {
    .tgr-delivery__heading { font-size: 48px; }
  }

  @keyframes tgrRise {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }
  .tgr-delivery__btn { opacity: 0; animation: tgrRise 0.5s ease forwards; }
  .tgr-delivery__btn--talabat { animation-delay: 60ms; }
  .tgr-delivery__btn--careem  { animation-delay: 120ms; }
  @media (prefers-reduced-motion: reduce) {
    .tgr-delivery__btn { opacity: 1; animation: none; }
  }
</style>

<div class="tgr-delivery">
  <main class="tgr-delivery__inner">
    {%- if section.settings.logo != blank -%}
      <img
        class="tgr-delivery__logo"
        src="{{ section.settings.logo | image_url: width: 480 }}"
        alt="The Green Room"
        width="{{ section.settings.logo.width }}"
        height="{{ section.settings.logo.height }}"
        loading="eager"
        decoding="async">
    {%- else -%}
      <div class="tgr-delivery__wordmark">The Green Room</div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="tgr-delivery__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if has_talabat or has_careem -%}
      {%- if section.settings.subheading != blank -%}
        <p class="tgr-delivery__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <div class="tgr-delivery__buttons">
        {%- if has_talabat -%}
          <a
            class="tgr-delivery__btn tgr-delivery__btn--talabat"
            href="{{ talabat_url }}"
            target="_blank"
            rel="noopener noreferrer"
            data-platform="talabat">
            {%- if section.settings.talabat_logo != blank -%}
              <img class="tgr-delivery__btn-logo" src="{{ section.settings.talabat_logo | image_url: height: 44 }}" alt="" aria-hidden="true" decoding="async">
            {%- endif -%}
            <span class="tgr-delivery__btn-label">{{ section.settings.talabat_label | default: 'Order on Talabat' | escape }}</span>
          </a>
        {%- endif -%}

        {%- if has_careem -%}
          <a
            class="tgr-delivery__btn tgr-delivery__btn--careem"
            href="{{ careem_url }}"
            target="_blank"
            rel="noopener noreferrer"
            data-platform="careem">
            {%- if section.settings.careem_logo != blank -%}
              <img class="tgr-delivery__btn-logo" src="{{ section.settings.careem_logo | image_url: height: 44 }}" alt="" aria-hidden="true" decoding="async">
            {%- endif -%}
            <span class="tgr-delivery__btn-label">{{ section.settings.careem_label | default: 'Order on Careem' | escape }}</span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.footnote != blank -%}
        <p class="tgr-delivery__footnote">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="tgr-delivery__placeholder">{{ section.settings.subheading | default: 'Pick your delivery app.' | escape }}</p>
    {%- endif -%}
  </main>
</div>

<script>
  (function () {
    try {
      var links = document.querySelectorAll('.tgr-delivery__btn[data-platform]');
      for (var i = 0; i < links.length; i++) {
        links[i].addEventListener('click', function () {
          var platform = this.getAttribute('data-platform');
          try {
            if (typeof window.dataLayer !== 'undefined' && typeof window.dataLayer.push === 'function') {
              window.dataLayer.push({ event: 'delivery_click', platform: platform });
            }
          } catch (e) {}
          try {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'delivery_click', { platform: platform });
            }
          } catch (e) {}
          // Never preventDefault: the anchor navigates normally so iOS/Android
          // universal links fire even if analytics is missing.
        });
      }
    } catch (e) {}
  })();
</script>

{% schema %}
{
  "name": "TGR delivery links",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "TGR logo", "info": "Optional. Falls back to the text wordmark \"The Green Room\"." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order Now" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick your delivery app." },
    { "type": "header", "content": "Talabat" },
    { "type": "url", "id": "talabat_url", "label": "Talabat URL", "info": "Pre-filled with the Green Room Talabat listing. Blank hides the button." },
    { "type": "text", "id": "talabat_label", "label": "Talabat button label", "default": "Order on Talabat" },
    { "type": "image_picker", "id": "talabat_logo", "label": "Talabat logo", "info": "Optional. Use the official asset unmodified. No logo falls back to the label alone." },
    { "type": "header", "content": "Careem" },
    { "type": "url", "id": "careem_url", "label": "Careem URL", "info": "Pre-filled with the Green Room Careem link. Blank hides the button." },
    { "type": "text", "id": "careem_label", "label": "Careem button label", "default": "Order on Careem" },
    { "type": "image_picker", "id": "careem_logo", "label": "Careem logo", "info": "Optional. Use the official asset unmodified (wordmark plus symbol). No logo falls back to the label alone." },
    { "type": "header", "content": "Page" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Delivery hours and availability are set by each app." },
    { "type": "checkbox", "id": "noindex", "label": "Hide from search engines (noindex)", "default": true }
  ]
}
{% endschema %}
