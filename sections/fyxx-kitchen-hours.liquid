{% comment %}
  ===== FYXX CUSTOM: Kitchen availability =====
  Website-only. On a gated product's page, disables Add to Cart (and the
  dynamic / Shop Pay / express buttons) and shows a note when that product's
  kitchen is closed, using Asia/Amman time. No hiding, no sales-channel
  changes, no scheduler. Membership is decided by rule (vendor / type /
  title), so new items are covered automatically. Scoped under .fyxx-kh.
  Renders nothing on non-gated products. Does NOT affect the mobile app.

  Disabling is CSS-driven via an html.fyxx-kh-closed class so it wins over the
  theme's own button re-renders; a capture-phase click/submit block is the
  safety net for the AJAX add-to-cart and express buttons.
{% endcomment %}

{%- liquid
  assign group = ''
  assign v = product.vendor
  assign t = product.type

  if v == 'Fyxx | The Green Room' and t == 'Fyxx Food'
    assign group = 'greenroom'
  elsif v == 'Select Food Shoppe' or t == 'Bundle | Wine & Cheese'
    assign group = 'cheese'
  elsif t == 'Pizza'
    assign group = 'pizza'
  elsif product.title contains 'Pizza' and v == 'Fyxx Bundles'
    assign group = 'pizza'
  elsif product.title contains 'Pizza' and v == 'Fyxx x UMG Bundles'
    assign group = 'pizza'
  endif

  case group
    when 'greenroom'
      assign kh_title = 'The Green Room kitchen is closed right now'
      assign kh_detail = 'Food is available Sun–Wed 5–11 PM, and Thu–Sat 12 PM–11:30 PM.'
    when 'cheese'
      assign kh_title = 'Cheese platters aren’t available right now'
      assign kh_detail = 'They can be ordered from 9 AM to 10 PM, daily.'
    when 'pizza'
      assign kh_title = 'The kitchen is closed for pizza right now'
      assign kh_detail = 'Last orders are 10 PM, daily.'
  endcase
-%}

{%- if group != blank -%}
  <div class="fyxx-kh" data-fyxx-kh data-group="{{ group }}">
    <div class="fyxx-kh-note" role="status" aria-live="polite" hidden>
      <span class="fyxx-kh-note__title">{{ kh_title }}</span>
      <span class="fyxx-kh-note__detail">{{ kh_detail }}</span>
    </div>
  </div>

  <style>
    .fyxx-kh{ margin:0; }
    .fyxx-kh-note{
      display:block; margin:12px 0 0; padding:12px 14px;
      border:1px solid #f0d5cb; border-left:3px solid #f0b09e; border-radius:10px;
      background:#fdf4f0; color:#3a2a24; font-size:14px; line-height:1.45;
    }
    .fyxx-kh-note__title{ display:block; font-weight:600; }
    .fyxx-kh-note__detail{ display:block; margin-top:2px; color:#6b544c; font-size:13px; }

    /* When closed, hard-disable the MAIN product's buy + express buttons.
       Scoped to block-buy-buttons (the PDP main form only), so recommendation
       cards etc. are untouched. pointer-events:none wins over theme re-renders. */
    html.fyxx-kh-closed block-buy-buttons .add-to-cart,
    html.fyxx-kh-closed block-buy-buttons button[name="add"],
    html.fyxx-kh-closed block-buy-buttons button[type="submit"]{
      pointer-events:none !important; opacity:.5 !important; cursor:not-allowed !important;
    }
    html.fyxx-kh-closed block-buy-buttons .shopify-payment-button,
    html.fyxx-kh-closed block-buy-buttons .element-button--shopify-payment-wrapper,
    html.fyxx-kh-closed block-buy-buttons shopify-accelerated-checkout{
      display:none !important;
    }
  </style>

  <script>
    (function(){
      var GROUP = {{ group | json }};
      var SCHED = {
        greenroom: {0:[1020,1380],1:[1020,1380],2:[1020,1380],3:[1020,1380],4:[720,1410],5:[720,1410],6:[720,1410]},
        cheese:    {0:[540,1320],1:[540,1320],2:[540,1320],3:[540,1320],4:[540,1320],5:[540,1320],6:[540,1320]},
        pizza:     {0:[0,1330],1:[0,1330],2:[0,1330],3:[0,1330],4:[0,1330],5:[0,1330],6:[0,1330]}
      };
      var sched = SCHED[GROUP];
      if(!sched) return;

      var wrap = document.querySelector('.fyxx-kh[data-group="'+GROUP+'"]');
      var note = wrap ? wrap.querySelector('.fyxx-kh-note') : null;

      function ammanNow(){
        try{
          var parts = new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Amman',weekday:'short',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date());
          var days={Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6}, wd=0,h=0,m=0;
          parts.forEach(function(p){ if(p.type==='weekday')wd=days[p.value]; else if(p.type==='hour')h=parseInt(p.value,10)%24; else if(p.type==='minute')m=parseInt(p.value,10); });
          return {day:wd, min:h*60+m};
        }catch(e){ return null; }
      }
      function isOpen(){
        var q=(location.search||'');
        if(q.indexOf('kh=closed')>-1) return false; /* test override */
        if(q.indexOf('kh=open')>-1) return true;     /* test override */
        var a=ammanNow(); if(!a) return true; /* fail open: never block on error */
        var w=sched[a.day]; return !!w && a.min>=w[0] && a.min<w[1];
      }

      function place(){
        var root=document.querySelector('block-buy-buttons');
        if(root && note && note.parentNode!==root){ root.appendChild(note); }
      }
      function apply(){
        var open=isOpen();
        document.documentElement.classList.toggle('fyxx-kh-closed', !open);
        place();
        if(note){ note.hidden = open; }
      }

      /* Safety net: swallow clicks + submits on the main buy area while closed.
         Capture phase + stopImmediatePropagation beats the theme's AJAX handlers. */
      document.addEventListener('click', function(e){
        if(isOpen()) return;
        var t = (e.target && e.target.closest) ? e.target.closest('block-buy-buttons') : null;
        if(t){ e.preventDefault(); e.stopImmediatePropagation(); }
      }, true);
      document.addEventListener('submit', function(e){
        var f=e.target;
        if(f && f.closest && f.closest('block-buy-buttons') && !isOpen()){ e.preventDefault(); e.stopImmediatePropagation(); }
      }, true);

      function start(){ apply(); setInterval(apply, 30000); }
      if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', start); } else { start(); }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Kitchen availability",
  "settings": [],
  "blocks": []
}
{% endschema %}
