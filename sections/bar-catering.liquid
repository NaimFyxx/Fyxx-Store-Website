<script>
  {%- comment -%} FYXX CUSTOM: scoped client validation + 7-day date notice + honeypot. No third-party scripts. {%- endcomment -%}
  (function(){
    var form = document.getElementById('bcForm');
    if(!form) return;

    var hp = form.querySelector('input[name="website"]');

    function fieldOf(el){ return el.closest('.fyxx-bc-field'); }
    function showErr(el, msg){
      var f = fieldOf(el); if(!f) return;
      var e = f.querySelector('.fyxx-bc-err');
      if(e){ e.textContent = msg; e.style.display = 'block'; }
      f.classList.add('has-err');
      el.setAttribute('aria-invalid','true');
    }
    function clearErr(el){
      var f = fieldOf(el); if(!f) return;
      var e = f.querySelector('.fyxx-bc-err');
      if(e){ e.textContent=''; e.style.display='none'; }
      f.classList.remove('has-err');
      el.removeAttribute('aria-invalid');
    }

    var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function validate(){
      var first = null;
      var fields = form.querySelectorAll('[data-label]');
      for(var i=0;i<fields.length;i++){
        var el = fields[i];
        var type = el.getAttribute('data-type') || '';
        var label = el.getAttribute('data-label') || 'This field';
        var isReq = el.hasAttribute('data-req');
        clearErr(el);

        if(type === 'check'){
          if(isReq && !el.checked){ showErr(el, 'Please accept the terms to continue.'); first = first || el; }
          continue;
        }

        var val = (el.value || '').trim();

        if(isReq && !val){ showErr(el, label + ' is required.'); first = first || el; continue; }
        if(!val) continue; /* optional & empty */

        if(type === 'email' && !emailRe.test(val)){ showErr(el, 'Please enter a valid email address.'); first = first || el; }
        else if((type === 'min1' || type === 'min1opt') && (isNaN(parseFloat(val)) || parseFloat(val) < 1)){ showErr(el, 'Please enter a number of 1 or more.'); first = first || el; }
      }
      return first;
    }

    form.addEventListener('submit', function(e){
      /* honeypot: silently refuse bots */
      if(hp && hp.value){ e.preventDefault(); return; }
      var first = validate();
      if(first){
        e.preventDefault();
        try { first.focus({preventScroll:true}); } catch(err){ first.focus(); }
        first.scrollIntoView({behavior:'smooth', block:'center'});
      }
    });

    /* 7-day notice: never blocks submit */
    var dateInput = document.getElementById('bc-date');
    var note = document.getElementById('bc-date-note');
    function checkDate(){
      if(!dateInput || !note) return;
      if(!dateInput.value){ note.hidden = true; return; }
      var chosen = new Date(dateInput.value + 'T00:00:00');
      if(isNaN(chosen.getTime())){ note.hidden = true; return; }
      var today = new Date(); today.setHours(0,0,0,0);
      var diff = Math.round((chosen - today) / 86400000);
      note.hidden = !(diff >= 0 && diff < 7);
    }
    if(dateInput){
      dateInput.addEventListener('change', checkDate);
      dateInput.addEventListener('input', checkDate);
      checkDate();
    }
  })();
</script>

