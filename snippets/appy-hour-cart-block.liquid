{%- comment -%}
  Fyxx: Appy Hour cart-page block.
  Rendered by snippets/section.main-cart.liquid: in the summary column above the
  subtotal when the cart has items, and in the empty-cart state (with
  cart_empty: true) so it still shows. Starts hidden; assets/appy-hour.js reveals
  and drives it (state, countdown, copy). On an empty cart, or in the teaser
  state, the Apply link is replaced by "BROWSE THE COLLECTION".

  @param {boolean} [cart_empty] - true when rendered in the empty-cart state.
{%- endcomment -%}
{%- capture appy_copy_icon -%}<svg class="appy-ic" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><rect x="5.75" y="5.75" width="8" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3.25 10.25H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h6.25a1 1 0 0 1 1 1v.25" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>{%- endcapture -%}

<div class="appy appy-cart-block{% if cart_empty %} appy-cart-block--empty{% endif %}" data-appy-block hidden>
  <div class="appy-cart-block__media">
    <img class="appy-cart-block__img"
      src="https://cdn.shopify.com/s/files/1/0108/6328/0224/files/Fyxx_App_Appy_Hour_Large_Banner.png?v=1791235303&width=800"
      width="1600" height="900" alt="Appy Hour, 6 to 7 pm" loading="lazy" decoding="async">
  </div>
  <div class="appy-cart-block__body">
    <div class="appy-cart-block__head">
      <span class="appy-cart-block__headline" data-appy="block-headline"></span>
      <span class="appy-chip appy-chip--count appy-cart-block__chip"><span data-appy="block-count">00:00</span></span>
    </div>
    <a class="appy-cart-block__apply" href="/discount/APPYHOUR?redirect=/cart">APPLY CODE APPYHOUR</a>
    <a class="appy-cart-block__browse" href="/collections/happy-hour">BROWSE THE COLLECTION</a>
    <p class="appy-cart-block__subline">Prepare your cart, code APPYHOUR goes live at 6 pm</p>
    <button type="button" class="appy-cart-block__copy" data-appy-copy aria-label="Copy code APPYHOUR"><span data-appy-copytext>or copy the code</span>{{ appy_copy_icon }}</button>
  </div>
</div>
