{%- comment -%}
  Fyxx: Appy Hour cart strip (slim, expandable).
  Used in two places:
    - the cart DRAWER, above the subtotal footer (context 'drawer', default);
    - the cart PAGE summary column, above the subtotal (context 'page').
  It starts hidden; assets/appy-hour.js reveals and drives it (state, countdown,
  explainer, expand, copy) and re-applies on fyxx-cart:open / fyxx-cart:mutated.
  Folded by default; the folded bar is the expand toggle. On / last call show the
  Apply link; teaser and empty carts show a Browse link instead.

  @param {string} [context] - 'drawer' (default) | 'page'
  @param {boolean} [cart_empty] - true to force the Browse link (empty cart).
{%- endcomment -%}
{%- assign context = context | default: 'drawer' -%}
{%- capture appy_copy_icon -%}<svg class="appy-ic" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><rect x="5.75" y="5.75" width="8" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3.25 10.25H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h6.25a1 1 0 0 1 1 1v.25" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>{%- endcapture -%}

<div class="appy appy-cart-strip appy-cart-strip--{{ context }}{% if cart_empty %} appy-cart-strip--empty{% endif %}" data-appy-strip hidden>
  <button type="button" class="appy-cart-strip__fold" data-appy-strip-toggle aria-expanded="false">
    <span class="appy-cart-strip__headline" data-appy="strip-headline"></span>
    <span class="appy-chip appy-chip--count appy-cart-strip__chip"><span data-appy="strip-count">00:00</span></span>
    <span class="appy-cart-strip__spacer" aria-hidden="true"></span>
    <span class="appy-cart-strip__use">Use code</span>
    <span class="appy-cart-strip__chev" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg></span>
  </button>
  <div class="appy-cart-strip__panel" data-appy-strip-panel hidden>
    <p class="appy-cart-strip__explainer" data-appy="strip-explainer"></p>
    <a class="appy-cart-strip__apply" href="/discount/APPYHOUR?redirect=/cart">APPLY CODE APPYHOUR</a>
    <a class="appy-cart-strip__browse" href="/collections/happy-hour">BROWSE THE COLLECTION</a>
    <button type="button" class="appy-cart-strip__copy" data-appy-copy aria-label="Copy code APPYHOUR"><span data-appy-copytext>or copy the code</span>{{ appy_copy_icon }}</button>
  </div>
</div>
