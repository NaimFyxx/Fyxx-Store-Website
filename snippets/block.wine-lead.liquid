{%- comment -%}
  Fyxx: Wine lead (product block)
  Renders the opening paragraph of a wine description, meaning the content
  before the first "<p><strong>" heading. It only renders when the description
  is in the structured six-part shape (three or more of the five known
  headings), so an odd description never has its whole body rendered here as a
  lead. Renders nothing otherwise, and nothing if there is no content before
  the first heading. See snippets/block.wine-details.liquid for the matching parse.

  Mounted as a block inside the product grid's content column, so the grid
  provides the left edge and measure; there is no page-width wrapper or narrow
  cap here.

  Font: the lead uses the theme's heading font via its token, set through the
  token rather than a hardcoded family name so it tracks any future theme font
  change. The paragraph is already wrapped in <em> in the data, so italics are
  not set in CSS.
{%- endcomment -%}

{%- liquid
  assign desc = product.description

  assign hcount = 0
  if desc contains '<strong>Tasting Notes</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>Quick Facts</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>Food Pairing</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>Serving</strong>'
    assign hcount = hcount | plus: 1
  endif
  if desc contains '<strong>About the Producer</strong>'
    assign hcount = hcount | plus: 1
  endif

  assign lead = ''
  if hcount >= 3
    assign lead = desc | split: '<p><strong>' | first | strip
  endif
-%}

{%- if lead != blank -%}
  <div class="wine-lead" style="padding-top:{{ block.settings.padding_top }}px;padding-bottom:{{ block.settings.padding_bottom }}px;" {{ block.shopify_attributes }}>
    <h2 class="wine-lead__heading">About this wine</h2>
    <div class="wine-lead__inner">
      {{ lead }}
    </div>
  </div>

  <style>
    .wine-lead__heading {
      font-family: var(--element-text-font-family--heading), var(--element-text-font-family-fallback--heading);
      font-size: 21px;
      font-weight: 400;
      line-height: 1.25;
      color: #100F0D;
      margin: 0 0 14px;
    }
    .wine-lead__inner,
    .wine-lead__inner p,
    .wine-lead__inner em {
      font-family: var(--element-text-font-family--heading), var(--element-text-font-family-fallback--heading);
      font-size: 17px;
      line-height: 1.75;
      color: #100F0D;
    }
    .wine-lead__inner p { margin: 0; }
    @media screen and (min-width: 768px) {
      .wine-lead__inner,
      .wine-lead__inner p,
      .wine-lead__inner em { font-size: 18px; }
    }
  </style>
{%- endif -%}
