        <a class="fx-rewards__pill" href="{{ routes.account_register_url }}?return_url={{ product.url }}">Create an account</a>
      </div>
    {%- endunless -%}
  </div>

  {%- stylesheet -%}
    .fx-rewards {
      border-radius: 10px;
      padding: 14px 16px;
      margin: 4px 0;
      color: #100F0D;
    }
    .fx-rewards--plain { background: #f7f7fa; }
    .fx-rewards--blue { background: linear-gradient(120deg, #8e9ac6, #bbc1d7); color: #100F0D; }
    .fx-rewards--gold { background: linear-gradient(120deg, #e6c786, #f0e7b8); color: #100F0D; }
    /* Silver lightened from the brand file (#717275 to #b3b4b5) so ink reads across the band. */
    .fx-rewards--silver { background: linear-gradient(120deg, #9a9b9d, #cfd0d1); color: #100F0D; }
    .fx-rewards--platinum { background: linear-gradient(120deg, #3a3a3c, #6b6b6e); color: #ffffff; }

    .fx-rewards__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .fx-rewards__logo {
      display: inline-flex;
      color: currentColor;
    }
    .fx-rewards__logo-svg {
      width: 56px;
      height: auto;
      display: block;
    }
    .fx-rewards__tier {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.85;
    }
    .fx-rewards__points {
      margin: 8px 0 0;
      font-size: 15px;
      font-weight: 600;
    }
    .fx-rewards__sub {
      margin: 2px 0 0;
      font-size: 12px;
      opacity: 0.8;
    }
    .fx-rewards__actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }
    .fx-rewards__pill {
      display: inline-block;
      padding: 8px 16px;
      border: 1px solid currentColor;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      color: currentColor;
      text-decoration: none;
    }
    .fx-rewards__pill:hover {
      background: rgba(16, 15, 13, 0.06);
    }
  {%- endstylesheet -%}
{%- endunless -%}
